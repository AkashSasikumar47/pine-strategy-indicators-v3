//@version=6
indicator("Parabolic SAR", "PSAR", overlay = true)

afStart = input.float(0.02, "AF Start", minval = 0.001, step = 0.01)
afIncrement = input.float(0.02, "AF Increment", minval = 0.001, step = 0.01)
afMax = input.float(0.2, "AF Max", minval = 0.001, step = 0.01)

psar = ta.sar(afStart, afIncrement, afMax)

plot(psar, "PSAR", color.rgb(147, 209, 24), 2, plot.style_circles)
